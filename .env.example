# Copy to .env and fill in. .env is git-ignored; never commit real values.
# `make` loads this file automatically.

# Postgres + pgvector (Docker, phase 1+)
DATABASE_URL=postgresql://pokechamp:pokechamp@localhost:5433/pokechamp

# Claude API key (phase 5+), read by the official anthropic SDK.
# Only `make ask` and `make eval-answers` call the API; tests use a fake LLM.
# Create one at https://platform.claude.com (set a monthly spend limit there).
ANTHROPIC_API_KEY=
